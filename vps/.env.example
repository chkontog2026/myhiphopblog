PORT=3020
HOST=127.0.0.1
DATA_DIR=/opt/myhiphopblog/data
SITE_URL=https://myhiphopblog.chkontog.com
SITE_TIME_ZONE=Europe/Athens
GOOGLE_ANALYTICS_ID=
ADMIN_PASSWORD=replace-with-a-long-password
SESSION_SECRET=replace-with-at-least-32-random-characters

# Backblaze B2 music storage (preferred)
B2_REGION=
B2_ENDPOINT=
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=myhiphopblog-downloads

# Temporary Cloudflare R2 fallback during migration/rollback
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=myhiphopblog-downloads
R2_PUBLIC_URL=https://downloads.myhiphopblog.ypotitloi.gr

# Optional: can also be saved securely from the admin panel
DISCOGS_TOKEN=

# Webshare proxy URLs, separated with semicolons. Keep this only in /opt/myhiphopblog/.env.
# Example: http://username:password@proxy.example:8080
WEBSHARE_PROXY_URLS=
